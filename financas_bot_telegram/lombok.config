# Configuracao do Lombok deste modulo.
#
# NAO APAGUE a linha abaixo sem entender o efeito: ela existe para a medicao de
# cobertura (JaCoCo), nao para o compilador.
#
# Sem ela, getter, setter, equals, hashCode, toString e builder GERADOS pelo Lombok
# entram na contagem do JaCoCo como codigo de producao nao coberto. O resultado e um
# baseline que mede quanto Lombok o projeto usa, nao quanto os testes cobrem — e a
# distorcao se concentra exatamente onde o Lombok gera mais codigo (application/dto,
# adapters/out, domain/model, domain/entity).
#
# Com ela, o Lombok anota o que gera com @lombok.Generated, e o JaCoCo exclui esse
# codigo por padrao (o suporte a @Generated e nativo do JaCoCo desde a 0.8.0).
#
# Efeito colateral: e uma anotacao a mais no bytecode gerado. Nenhum efeito em runtime.
lombok.addLombokGeneratedAnnotation = true
